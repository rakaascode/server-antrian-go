# Database
DB_HOST=db
DB_PORT=5432
DB_USER=admin
DB_PASS=ta-lautan
DB_NAME=ta_lautan_db

# JWT Secret — ganti dengan string random yang panjang di production!
JWT_SECRET=ganti-dengan-secret-yang-sangat-panjang-dan-random

# Google OAuth — Client ID dari Google Cloud Console (untuk Android)
# Kosongkan untuk skip validasi audience (mode development/lokal)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Fonnte API (WhatsApp)
FONNTE_TOKEN=token-fonnte-anda-disini
